{
  "name": "@ferreteria/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Contratos de tipos compartidos entre apps/web y apps/api (sin runtime)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/"
  },
  "devDependencies": {
    "@ferreteria/config": "workspace:*",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2"
  }
}
