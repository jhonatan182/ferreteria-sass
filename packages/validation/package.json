{
  "name": "@ferreteria/validation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Esquemas de validacion runtime compartidos (zod)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ferreteria/config": "workspace:*",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2"
  }
}
