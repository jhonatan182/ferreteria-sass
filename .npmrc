# El entorno tiene un shim de corepack (pnpm 9.x) además de pnpm 10.x.
# Sin esto, los scripts que invocan `pnpm` de forma anidada fallan con
# ERR_PNPM_BAD_PM_VERSION. El formato de lockfile 9.0 es compatible entre
# pnpm 9 y 10, así que desactivar la comprobación estricta es seguro aquí.
package-manager-strict=false
manage-package-manager-versions=false
