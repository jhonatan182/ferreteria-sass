# Copiar a .env y completar. NUNCA versionar .env (docs/07-ARQUITECTURA-TECNICA.md 32).

NODE_ENV=development

# --- PostgreSQL ---------------------------------------------------------------
# Coincide con docker-compose.yml (puerto host 5433). En produccion: PostgreSQL administrado.
DATABASE_URL="postgresql://ferreteria:ferreteria@localhost:5433/ferreteria?schema=public"

# --- Autenticacion -----------------------------------------------------------
# Generar: openssl rand -base64 32   (PowerShell: ver README / CLAUDE.md)
AUTH_SECRET=""

# --- URLs -------------------------------------------------------------------
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
API_PORT=4000

# CORS del backend: origen del frontend permitido.
WEB_ORIGIN="http://localhost:3000"

# --- Frontend (expuesto al navegador) --------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# --- Seed (pnpm db:seed) ---------------------------------------------------
# El catalogo de plataforma (permisos, features) se siembra en cualquier
# entorno. Lo siguiente solo se aplica fuera de produccion.
#
# Platform Admin de desarrollo. Sin contrasena: la autenticacion se define
# en una fase posterior y establecera la credencial.
PLATFORM_ADMIN_EMAIL="admin@localhost"
PLATFORM_ADMIN_NAME="Platform Admin"
# Tenant de desarrollo y su usuario propietario (rol OWNER).
DEV_TENANT_NAME="Ferreteria Demo"
DEV_TENANT_OWNER_EMAIL="owner@localhost"
DEV_TENANT_OWNER_NAME="Owner Demo"
