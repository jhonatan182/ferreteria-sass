# Copiar a .env y completar. NUNCA versionar .env (docs/07-ARQUITECTURA-TECNICA.md 32).

NODE_ENV=development

# --- PostgreSQL ---------------------------------------------------------------
# Coincide con docker-compose.yml (puerto host 5433). En produccion: PostgreSQL administrado.
DATABASE_URL="postgresql://ferreteria:ferreteria@localhost:5433/ferreteria?schema=public"

# --- Autenticacion -----------------------------------------------------------
# Reservado para futuros usos (firma de tokens de un solo uso, etc.). La sesion
# actual es opaca con estado en BD y NO necesita este secreto.
# Generar: openssl rand -base64 32   (PowerShell: ver README / CLAUDE.md)
AUTH_SECRET=""

# Sesion (todos opcionales; estos son los valores por defecto).
SESSION_TTL_HOURS=168              # expiracion deslizante de la sesion (7 dias)
BCRYPT_COST=12                     # coste del hash de contrasenas
SESSION_COOKIE_SAMESITE=lax        # lax | strict | none  (none exige HTTPS)
# Rate limit de POST /auth/login (por IP).
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_TTL_SECONDS=60

# --- URLs -------------------------------------------------------------------
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
API_PORT=4000

# CORS del backend: origen del frontend permitido.
WEB_ORIGIN="http://localhost:3000"

# --- Frontend (expuesto al navegador) --------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# --- Seed (pnpm db:seed) ---------------------------------------------------
# El catalogo de plataforma (permisos, features) se siembra en cualquier
# entorno. Lo siguiente solo se aplica fuera de produccion.
#
# Platform Admin de desarrollo. La contrasena solo se aplica fuera de
# produccion y solo si el usuario aun no tiene una (default: admin-dev-2026).
PLATFORM_ADMIN_EMAIL="admin@localhost"
PLATFORM_ADMIN_NAME="Platform Admin"
PLATFORM_ADMIN_PASSWORD=""
# Tenant de desarrollo y su usuario propietario (rol OWNER).
DEV_TENANT_NAME="Ferreteria Demo"
DEV_TENANT_OWNER_EMAIL="owner@localhost"
DEV_TENANT_OWNER_NAME="Owner Demo"
DEV_TENANT_OWNER_PASSWORD=""      # default: owner-dev-2026
