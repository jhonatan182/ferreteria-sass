// Esquema Prisma.
//
// Fase 2 — Fundacion SaaS e Identidad (docs/04-MODELO-DE-DOMINIO.md 1771-1791):
//   Identidad:  User, Tenant, TenantMembership, Role, Permission, RolePermission
//   Plataforma: Plan, Feature, PlanFeature, PlanLimit,
//               Subscription, SubscriptionPeriod, SaaSPayment, PlatformAuditLog
//
// Fase 3 — Autenticacion y contexto (docs/07-ARQUITECTURA-TECNICA.md 154-214):
//   Session (sesion opaca en BD; ver decisiones en docs/07 seccion 43)
//
// Fase 4 — Catalogo de productos (docs/04 473-608, decisiones en docs/04 seccion 45):
//   Unit, Category, Brand, Product, ProductPresentation, TenantProductSequence,
//   AuditLog (operativo, append-only)
//
// Fase 5 — Inventario (docs/04 616-693 y 1253-1274, decisiones en docs/04 seccion 46):
//   InventoryBalance, InventoryMovement, InventoryAdjustment
//   Enums InventoryMovementType, InventoryAdjustmentDirection
//
// Fuera de alcance (fases posteriores, cada una con su migracion — AGENTS.md 22):
//   compras, ventas, clientes, proveedores, caja, creditos, reportes.
//
// Reglas al modelar (docs/07-ARQUITECTURA-TECNICA.md 10-13, 233-257):
//   - IDs = UUID
//   - dinero = Decimal, nunca Float (AGENTS.md 11)
//   - relaciones explicitas e indices tenant-aware
//   - unicidad compuesta por tenant cuando corresponda
//   - timestamps createdAt/updatedAt salvo en logs append-only
//
// Convencion de nombres fisicos: snake_case plural via @@map / @map
// (la documentacion no la fija; se elige por legibilidad del SQL crudo,
//  que aun se necesita para el indice parcial de Subscription — ver abajo).

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

// docs/00-DISENO-SAAS.md 259-266, docs/04 412-419, AGENTS.md 249-257.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED

  @@map("subscription_status")
}

// RN-090 exige un estado por periodo pero la doc no enumera valores.
// Minimo que cubre el ciclo RF-155/156/157.
enum SubscriptionPeriodStatus {
  PENDING
  PAID
  CANCELLED

  @@map("subscription_period_status")
}

enum BillingInterval {
  MONTHLY
  YEARLY

  @@map("billing_interval")
}

/// Estado de una entidad de catalogo (RN-009, docs/04 1416-1445): sin borrado
/// fisico cuando puede tener historial; se activa / desactiva.
enum CatalogStatus {
  ACTIVE
  INACTIVE

  @@map("catalog_status")
}

/// Tipo de movimiento de inventario (Fase 5; docs/04 645-693, decisiones docs/04 seccion 46).
/// docs/04 651-658 lista EJEMPLOS; este es el catalogo cerrado para el sistema completo.
/// Divergencia documentada de los ejemplos:
///   RETURN_IN   = devolucion de venta que ENTRA a inventario (ej. de docs/04: "SALE_RETURN")
///   RETURN_OUT  = devolucion a proveedor que SALE de inventario (ej.: "PURCHASE_RETURN")
///   REVERSAL    = reverso de una operacion completada (cancelacion de venta / compra)
/// PURCHASE / SALE los generaran sus fases; aqui solo se producen ADJUSTMENT_IN/OUT.
enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL

  @@map("inventory_movement_type")
}

/// Direccion de un ajuste manual de inventario (docs/04 1253-1274, docs/05 626-681).
enum InventoryAdjustmentDirection {
  IN
  OUT

  @@map("inventory_adjustment_direction")
}

// ---------------------------------------------------------------------------
// Identidad
// ---------------------------------------------------------------------------

/// Persona que puede autenticarse en la plataforma (docs/04 107-135).
/// GLOBAL: no pertenece a un tenant; la relacion se da via TenantMembership.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  email           String
  /// Nullable en esta fase: la autenticacion (algoritmo de hash) se define
  /// en la fase siguiente. El seed crea usuarios sin credencial.
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(ACTIVE)
  /// Administrador de la plataforma SaaS (docs/03 123-167, RN-097).
  /// No es un rol de tenant. Un platform admin no tiene TenantMembership,
  /// por lo que RP-008 (sin acceso automatico al tenant) se cumple de raiz.
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  memberships                  TenantMembership[]
  sessions                     Session[]
  saasPaymentsRecorded         SaaSPayment[]         @relation("SaaSPaymentRecordedBy")
  platformAuditLogs            PlatformAuditLog[]    @relation("PlatformAuditActor")
  auditLogs                    AuditLog[]
  inventoryMovements           InventoryMovement[]
  inventoryAdjustmentsCreated  InventoryAdjustment[] @relation("InventoryAdjustmentCreatedBy")
  inventoryAdjustmentsApproved InventoryAdjustment[] @relation("InventoryAdjustmentApprovedBy")

  @@unique([email])
  @@index([status])
  @@index([isPlatformAdmin])
  @@map("users")
}

/// Una ferreteria / empresa cliente (docs/04 186-208). Raiz del aislamiento.
model Tenant {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String
  legalName            String?      @map("legal_name")
  identificationNumber String?      @map("identification_number")
  phone                String?
  email                String?
  address              String?
  status               TenantStatus @default(ACTIVE)
  /// Moneda base del negocio (docs/07 766-772: "no hardcodear HNL en reglas").
  /// Distinta de Plan.currency, que es la moneda con que la plataforma cobra.
  baseCurrency         String       @default("HNL") @map("base_currency") @db.Char(3)
  /// docs/07 756-761: timestamps en UTC, se muestran en la zona del tenant.
  timezone             String       @default("America/Tegucigalpa")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  memberships          TenantMembership[]
  roles                Role[]
  subscriptions        Subscription[]
  subscriptionPeriods  SubscriptionPeriod[]
  saasPayments         SaaSPayment[]
  activeSessions       Session[]
  units                Unit[]
  categories           Category[]
  brands               Brand[]
  products             Product[]
  productPresentations ProductPresentation[]
  productSequence      TenantProductSequence?
  auditLogs            AuditLog[]
  inventoryBalances    InventoryBalance[]
  inventoryMovements   InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[]

  @@index([status])
  @@index([identificationNumber])
  @@map("tenants")
}

/// Relacion usuario <-> tenant con un rol (docs/04 140-181).
/// Un solo rol por membresia en V1 (multiples roles = extension futura, docs/03 986-991).
model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
  @@index([roleId])
  @@map("tenant_memberships")
}

/// Rol dentro de un tenant (docs/04 214-243). TENANT-OWNED.
/// isSystem marca los roles predefinidos protegidos (docs/03 461-465).
/// Sin herencia entre roles en V1 (docs/03 747-761).
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships TenantMembership[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// Accion autorizable (docs/04 247-265). CATALOGO GLOBAL: sin tenantId.
/// code = "modulo.accion" (docs/03 475-636). 70 permisos en el seed.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@unique([code])
  @@index([module])
  @@map("permissions")
}

/// Puente Role <-> Permission (docs/04 269-281).
/// @@unique evita el mismo permiso dos veces en un rol (RP-020).
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Autenticacion (Fase 3)
// ---------------------------------------------------------------------------

/// Sesion autenticada de un usuario (docs/07 154-169; decisiones en docs/07 seccion 43).
///
/// Sesion OPACA con estado en BD: el navegador solo guarda un token aleatorio
/// en una cookie httpOnly; aqui se guarda unicamente su hash SHA-256. Permite
/// cumplir RF-004 ("invalidar la sesion actual") de forma real y cortar el
/// acceso al instante cuando el usuario se desactiva.
///
/// `activeTenantId` es la unica fuente del tenant activo (docs/00 191-203,
/// RN-003): el backend nunca acepta un tenantId de la peticion como prueba de
/// pertenencia; la seleccion se persiste aqui y se revalida contra
/// TenantMembership en cada request.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) del token de sesion. El token en claro nunca se persiste.
  tokenHash      String    @unique @map("token_hash")
  /// Tenant seleccionado para esta sesion. NULL mientras el usuario con varias
  /// membresias no ha elegido (docs/05 128-155).
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")
  /// Expiracion absoluta. Se desliza en cada uso hasta este tope.
  expiresAt      DateTime  @map("expires_at")
  /// Revocacion explicita (logout, desactivacion del usuario, cambio de credencial).
  revokedAt      DateTime? @map("revoked_at")
  lastUsedAt     DateTime  @default(now()) @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Plataforma SaaS
// ---------------------------------------------------------------------------

/// Plan comercial de la plataforma (docs/04 287-313). GLOBAL.
/// `code` da identidad estable para el seed. PROHIBIDO ramificar logica por
/// code o name: usar Feature / PlanLimit (AGENTS.md 19, docs/00 209-237).
model Plan {
  id              String          @id @default(uuid()) @db.Uuid
  code            String
  name            String
  description     String?
  price           Decimal         @default(0) @map("price") @db.Decimal(12, 2)
  /// Moneda con que la plataforma cobra la suscripcion (no la del negocio).
  currency        String          @default("HNL") @db.Char(3)
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  /// docs/00 286-288 / RN-092: 7 dias por defecto, configurable a nivel plataforma.
  gracePeriodDays Int             @default(7) @map("grace_period_days")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  features            PlanFeature[]
  limits              PlanLimit[]
  subscriptions       Subscription[]
  subscriptionPeriods SubscriptionPeriod[]

  @@unique([code])
  @@index([isActive])
  @@map("plans")
}

/// Funcionalidad activable por plan (docs/04 317-328). CATALOGO GLOBAL.
model Feature {
  id          String   @id @default(uuid()) @db.Uuid
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  plans PlanFeature[]

  @@unique([code])
  @@map("features")
}

/// Puente Plan <-> Feature (docs/04 332-352).
model PlanFeature {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  featureId String   @map("feature_id") @db.Uuid
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
}

/// Limite comercial de un plan (docs/04 356-379). key/value.
/// value NULL = sin limite comercial (docs/00 255).
model PlanLimit {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  key       String
  value     Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("plan_limits")
}

/// Suscripcion de un tenant a un plan (docs/04 386-427). TENANT-OWNED.
/// currentPeriodStart/End se duplican del periodo vigente a proposito
/// (docs/04 400-409) para evitar un join en el guard de suscripcion.
/// El historial vive en SubscriptionPeriod (RN-090).
/// Un solo registro vigente por tenant: indice parcial en la migracion
/// (subscription_one_active_per_tenant), no expresable en Prisma.
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  startDate          DateTime           @map("start_date")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  /// Fin del periodo de gracia una vez en PAST_DUE (lo calcula la fase del job).
  gracePeriodEndsAt  DateTime?          @map("grace_period_ends_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan     Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  periods  SubscriptionPeriod[]
  payments SaaSPayment[]

  @@index([tenantId, status])
  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Periodo historico de una suscripcion (docs/04 431-443, RN-090).
/// Conserva el plan usado en ese periodo aunque el tenant cambie de plan.
model SubscriptionPeriod {
  id             String                   @id @default(uuid()) @db.Uuid
  subscriptionId String                   @map("subscription_id") @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  planId         String                   @map("plan_id") @db.Uuid
  periodStart    DateTime                 @map("period_start")
  periodEnd      DateTime                 @map("period_end")
  status         SubscriptionPeriodStatus @default(PENDING)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments     SaaSPayment[]

  @@unique([subscriptionId, periodStart])
  @@index([tenantId])
  @@map("subscription_periods")
}

/// Pago del tenant al proveedor del SaaS (docs/04 447-469, RF-154).
/// SEPARADO de SalePayment / CreditMovement / CashMovement (MD-008).
/// Registro individual por pago, nunca un booleano `paid` (RN-089).
model SaaSPayment {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  subscriptionId       String   @map("subscription_id") @db.Uuid
  subscriptionPeriodId String?  @map("subscription_period_id") @db.Uuid
  amount               Decimal  @db.Decimal(12, 2)
  currency             String   @default("HNL") @db.Char(3)
  paidAt               DateTime @map("paid_at")
  reference            String?
  notes                String?
  /// Platform Admin que registro el pago (RF-154).
  recordedByUserId     String   @map("recorded_by_user_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription       Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  subscriptionPeriod SubscriptionPeriod? @relation(fields: [subscriptionPeriodId], references: [id], onDelete: Restrict)
  recordedBy         User                @relation("SaaSPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  /// Idempotencia de registro. Postgres trata los NULL como distintos,
  /// asi que varios pagos sin referencia no colisionan.
  @@unique([tenantId, reference])
  @@index([subscriptionId])
  @@index([tenantId, paidAt])
  @@index([recordedByUserId])
  @@map("saas_payments")
}

/// Auditoria de operaciones administrativas del SaaS (docs/04 1319-1348).
/// SEPARADA del AuditLog operativo. Append-only: sin updatedAt, sin delete
/// desde la aplicacion (docs/04 1313-1315, AGENTS.md 184-194).
model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Actor: Platform Admin. Nullable para eventos de sistema (jobs).
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Tenant afectado, cuando aplique (TENANT_CREATED, SUBSCRIPTION_SUSPENDED...).
  tenantId    String?  @map("tenant_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("platform_audit_logs")
}

// ---------------------------------------------------------------------------
// Productos y catalogos (Fase 4)
// ---------------------------------------------------------------------------
//
// docs/04 473-608, docs/05 236-448, docs/06 171-241, docs/02 93-264.
// Decisiones que la documentacion no cerraba: docs/04 seccion 45.
//   - Unit es TENANT-OWNED (docs/04 seccion 45, D1): docs/04 569-571 permitia
//     un catalogo global, pero `products.manage_units` es un permiso de tenant.
//   - internalCode se autogenera con una tabla contador por tenant
//     (TenantProductSequence, D2) para no depender de MAX+1 bajo concurrencia.
//   - Sin costo en esta fase (D4): `averageCost` pertenece a InventoryBalance
//     (docs/04 616-643) y nace con el modulo de inventario / compras.

/// Unidad de medida de un tenant (docs/04 552-571, RN-011). TENANT-OWNED.
/// El inventario se controla en la unidad base del producto; las presentaciones
/// definen como se comercializa (docs/04 610-613).
model Unit {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  code      String
  name      String
  symbol    String?
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  baseUnitOfProducts Product[]             @relation("ProductBaseUnit")
  presentations      ProductPresentation[]
  inventoryMovements InventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("units")
}

/// Categoria de productos de un tenant (docs/04 512-527, RN-002). TENANT-OWNED.
model Category {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  name        String
  description String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("categories")
}

/// Marca de producto de un tenant (docs/04 531-546, RN-002). TENANT-OWNED.
model Brand {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  name        String
  description String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("brands")
}

/// Articulo comercializado por la ferreteria (docs/04 475-508, RN-005..RN-010).
/// TENANT-OWNED. `internalCode` y `barcode` son conceptos distintos (RN-008):
///   - internalCode: unico por tenant, autogenerado si no se envia (docs/05 290-318)
///   - barcode:      opcional; cuando existe, unico por tenant (RN-007)
/// Sin borrado fisico (RN-010): status ACTIVE / INACTIVE.
model Product {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  internalCode String        @map("internal_code")
  barcode      String?
  name         String
  description  String?
  categoryId   String?       @map("category_id") @db.Uuid
  brandId      String?       @map("brand_id") @db.Uuid
  baseUnitId   String        @map("base_unit_id") @db.Uuid
  status       CatalogStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                Brand?                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  baseUnit             Unit                  @relation("ProductBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  presentations        ProductPresentation[]
  inventoryBalances    InventoryBalance[]
  inventoryMovements   InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[]

  /// Postgres trata los NULL como distintos: varios productos sin barcode no
  /// colisionan (mismo comportamiento que SaaSPayment.reference, docs/07 246-257).
  @@unique([tenantId, internalCode])
  @@unique([tenantId, barcode])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([categoryId])
  @@index([brandId])
  @@index([baseUnitId])
  @@map("products")
}

/// Presentacion o unidad comercial de un producto (docs/04 575-613, RN-012..RN-016).
/// `conversionFactor` convierte a la unidad base (docs/04 203-217); `salePrice`
/// es independiente por presentacion (RN-015). Una sola presentacion principal
/// por producto: indice unico parcial en la migracion
/// (product_one_default_presentation), no expresable en Prisma.
model ProductPresentation {
  id               String        @id @default(uuid()) @db.Uuid
  /// Desnormalizado del producto para consultas tenant-aware directas (AGENTS.md 5).
  tenantId         String        @map("tenant_id") @db.Uuid
  productId        String        @map("product_id") @db.Uuid
  unitId           String        @map("unit_id") @db.Uuid
  name             String
  conversionFactor Decimal       @map("conversion_factor") @db.Decimal(18, 6)
  salePrice        Decimal       @map("sale_price") @db.Decimal(14, 4)
  isDefault        Boolean       @default(false) @map("is_default")
  status           CatalogStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([productId, name])
  @@index([tenantId, productId, status])
  @@index([unitId])
  @@map("product_presentations")
}

/// Contador de codigo interno por tenant (docs/05 290-318, RN-006). El prefijo
/// es configurable por tenant. La generacion se hace con
/// `UPDATE ... SET next_value = next_value + 1 RETURNING` DENTRO de la
/// transaccion de creacion del producto: el row lock de Postgres serializa a los
/// concurrentes (AGENTS.md 21). Nunca `SELECT MAX(internal_code) + 1`.
model TenantProductSequence {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  prefix    String   @default("FER")
  padding   Int      @default(6)
  nextValue Int      @default(1) @map("next_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_product_sequences")
}

/// Auditoria operativa de un tenant (docs/04 1278-1315, RN-076, RF-140).
/// SEPARADA de PlatformAuditLog (operaciones del SaaS). Append-only: sin
/// updatedAt, sin delete ni update desde la aplicacion (docs/04 1313-1315).
/// La escritura ocurre DENTRO de la misma transaccion que la operacion auditada
/// (docs/05 1782-1810).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Actor. Nullable para eventos de sistema (jobs) y para no perder el registro
  /// si el usuario se elimina fisicamente en el futuro.
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Inventario (Fase 5)
// ---------------------------------------------------------------------------
//
// docs/04 616-693 y 1253-1274, docs/05 626-746, docs/06 244-288, docs/02 268-345.
// docs/07 292-406 (materializacion, concurrencia por row lock, costo promedio
// ponderado dentro de la transaccion). Decisiones que la documentacion no
// cerraba: docs/04 seccion 46.
//
// Fuente de verdad:
//   InventoryMovement  -> historial (append-only, sin update/delete desde la app)
//   InventoryBalance   -> estado actual materializado (nunca se fija `quantity`
//                         desde un CRUD; solo cambia via una operacion de dominio
//                         que genera un InventoryMovement — RN-019/RN-024, MD-006)
//
// El inventario se almacena EXCLUSIVAMENTE en la unidad base del producto
// (RN-014). Las operaciones futuras con presentaciones convierten antes de
// afectar inventario: baseQuantity = quantity * conversionFactor
// (utilidades listas en apps/api/src/inventory/inventory.core.ts).

/// Existencia actual de un producto, en unidad base (docs/04 616-643).
/// `averageCost` es la FUENTE DE VERDAD del costo promedio ponderado del producto
/// en esta fase (docs/04 seccion 46; Product no tiene campo de costo). Compras lo
/// recalculara dentro de su transaccion con computeWeightedAverage.
model InventoryBalance {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  averageCost Decimal  @default(0) @map("average_cost") @db.Decimal(18, 6)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Como maximo un balance por producto y tenant para V1 (docs/04 seccion 46).
  @@unique([tenantId, productId])
  @@index([tenantId])
  @@map("inventory_balances")
}

/// Movimiento que modifica inventario (docs/04 645-693, RN-019..RN-021).
/// APPEND-ONLY: sin `updatedAt`, sin update ni delete desde la aplicacion
/// (AGENTS.md 184-194; las correcciones son movimientos compensatorios).
/// Referencia al documento origen con `referenceType` + `referenceId`
/// (docs/04 695-736), no con FKs nullable por tipo de documento.
model InventoryMovement {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  productId         String                @map("product_id") @db.Uuid
  type              InventoryMovementType
  /// Cantidad en la unidad en que se capturo la operacion (magnitud, sin signo).
  quantity          Decimal               @db.Decimal(18, 4)
  /// Unidad en que se capturo. En ajustes es la unidad base del producto.
  unitId            String                @map("unit_id") @db.Uuid
  /// Cantidad que afecta al inventario, en unidad base y CON SIGNO:
  /// positiva = entra, negativa = sale (docs/04 680-693).
  baseQuantity      Decimal               @map("base_quantity") @db.Decimal(18, 4)
  /// Saldo en unidad base antes y despues del movimiento (trazabilidad del
  /// kardex: "como se llego al saldo actual" — RN-025, docs/05 714-744).
  previousQuantity  Decimal               @map("previous_quantity") @db.Decimal(18, 4)
  resultingQuantity Decimal               @map("resulting_quantity") @db.Decimal(18, 4)
  /// Costo unitario asociado. Para movimientos sin costo propio (ajustes) se
  /// guarda el `averageCost` vigente como snapshot (docs/04 seccion 46).
  unitCost          Decimal?              @map("unit_cost") @db.Decimal(18, 6)
  reason            String?
  referenceType     String?               @map("reference_type")
  referenceId       String?               @map("reference_id") @db.Uuid
  /// Usuario responsable. Nullable para eventos de sistema y para no perder el
  /// registro si el usuario se elimina fisicamente en el futuro.
  userId            String?               @map("user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product    Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit       Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  adjustment InventoryAdjustment?

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

/// Ajuste manual de inventario (docs/04 1253-1274, docs/05 626-681, RP-024).
/// Se expresa como DIFERENCIA (+/-), nunca como "stock = N". Motivo obligatorio.
/// Genera exactamente un InventoryMovement (ADJUSTMENT_IN / ADJUSTMENT_OUT) y un
/// AuditLog dentro de la misma transaccion.
/// `approvedById` queda reservado para un futuro flujo de doble aprobacion
/// (`inventory.adjust_approve`); sin uso en V1 (docs/03 493-503).
model InventoryAdjustment {
  id           String                       @id @default(uuid()) @db.Uuid
  tenantId     String                       @map("tenant_id") @db.Uuid
  productId    String                       @map("product_id") @db.Uuid
  direction    InventoryAdjustmentDirection
  /// Magnitud positiva del ajuste, en unidad base.
  quantity     Decimal                      @db.Decimal(18, 4)
  reason       String
  movementId   String                       @unique @map("movement_id") @db.Uuid
  createdById  String                       @map("created_by_id") @db.Uuid
  approvedById String?                      @map("approved_by_id") @db.Uuid
  createdAt    DateTime                     @default(now()) @map("created_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  movement   InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  createdBy  User              @relation("InventoryAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?             @relation("InventoryAdjustmentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, createdAt])
  @@map("inventory_adjustments")
}
