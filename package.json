{
  "name": "ferreteria-saas",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema SaaS multi-tenant de gestion para ferreterias",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "pnpm --parallel --filter \"./packages/*\" --filter \"./apps/*\" run dev",
    "dev:web": "pnpm --filter @ferreteria/web run dev",
    "dev:api": "pnpm --filter @ferreteria/api run start:dev",
    "build": "pnpm run db:generate && pnpm --filter \"./packages/*\" run build && pnpm --filter \"./apps/*\" run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@ferreteria/config": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.0.0",
    "oxlint": "^1.58.0",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2"
  }
}
